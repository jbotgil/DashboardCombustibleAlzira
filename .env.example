# =============================================================================
# CONFIGURACIÓN DE MONGODB
# =============================================================================
# Este archivo es una PLANTILLA. Copia este archivo como .env
# Ejecuta: cp .env.example .env
#
# IMPORTANTE: El archivo .env está en .gitignore para proteger tus credenciales.
# NUNCA subas el archivo .env con contraseñas reales a GitHub.
# =============================================================================

# Host donde está corriendo MongoDB
# - Para Docker local: dejar "localhost"
# - Para producción: usar la IP o dominio del servidor
MONGO_HOST=localhost

# Puerto de MongoDB
# - El puerto por defecto de MongoDB es 27017
# - Debe coincidir con el puerto expuesto en compose.yaml
MONGO_PORT=27017

# Usuario de MongoDB
# - Debe coincidir con MONGO_INITDB_ROOT_USERNAME en compose.yaml
MONGO_USER=admin

# Contraseña de MongoDB
# - Debe coincidir con MONGO_INITDB_ROOT_PASSWORD en compose.yaml
# - ⚠️ CAMBIA esta contraseña en producción
MONGO_PASS=miPassword123

# =============================================================================
# NOTAS SOBRE LA CONFIGURACIÓN CON DOCKER
# =============================================================================
#
# Los valores por defecto están configurados para funcionar con compose.yaml:
#   - MongoDB: admin / miPassword123
#   - Mongo Express: adminweb / webPass123
#
# Si modificas las credenciales en compose.yaml, actualiza también este archivo
# y ejecuta: docker compose down && docker compose up -d
# =============================================================================
